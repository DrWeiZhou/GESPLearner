# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# 真题 PDF 由 `bun run crawl` 下载（约 130MB），不入库
/data/pdf/

# 数据库备份含账号与作答记录，只留在本地（`bun run backup`）
/data/backups/

# Monaco is copied from node_modules (scripts/desktop/copy-monaco.mjs)
/public/monaco/

# Local SQLite database (bun run dev) and desktop build output
/data/gesp.db*
/data/secret.key
/dist-desktop/
/build-desktop/
/.next-desktop/
