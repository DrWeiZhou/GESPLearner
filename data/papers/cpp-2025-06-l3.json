      "referenceSolution": "#include <cstdio>\n#include <algorithm>\nusing namespace std;\n\nconst int N = 1005;\n\nint n, a[N];\nlong long ans;\n\nint main() {\n    scanf(\"%d\", &n);\n    for (int i = 1; i <= n; i++) {\n        scanf(\"%d\", &a[i]);\n        a[i] = max(a[i - 1] + 1, a[i]);\n        ans += a[i];\n    }\n    printf(\"%lld\\n\", ans);\n    return 0;\n}\n"
